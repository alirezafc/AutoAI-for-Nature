# ============================================================
# AutoAI V1 — Environment Variables
#
# This file lists EVERY variable the source code actually reads.
# Copy to `.env.local` for local development. On Vercel, configure
# the same variables in Project → Settings → Environment Variables.
#
# All keys below are SERVER-ONLY. The only public variable is
# NEXT_PUBLIC_APP_URL. No secrets use the NEXT_PUBLIC_ prefix.
# ============================================================

# --- Database (server-only) -------------------------------------
# Production REQUIRES a managed PostgreSQL + pgvector connection string.
# The app refuses to boot in production without it (PGlite is dev-only).
# After setting it: npm run db:migrate
DATABASE_URL=

# --- Admin authentication (server-only secrets) ------------------
# Production bootstrap credentials for /admin. The well-known demo
# defaults (admin@autoai.local / autoai-admin) are DISABLED in production;
# both variables must be set explicitly there.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret that signs admin session JWTs (HS256). REQUIRED in production:
# 32+ random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# --- AI providers (server-only API keys) -------------------------
# At least one real provider key is required for live AI. Mock is dev-only
# and hard-fails outside automated tests.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional override of the OpenRouter base URL (integration tests only).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default provider/model used by agents + chatbot when no DB config exists.
# provider keys: mock | openrouter | openai | anthropic | google | groq
# Production verified configuration:
#   DEFAULT_AI_PROVIDER=openrouter
#   DEFAULT_AI_MODEL=openai/gpt-4o-mini
DEFAULT_AI_PROVIDER=mock
DEFAULT_AI_MODEL=autoai-demo-1

# Default embedding provider/model used by RAG indexing + retrieval.
# MUST emit exactly 2048 dimensions (see EMBEDDING_DIMENSIONS contract).
# Changing the embedding model requires a FULL knowledge-base re-index.
# Production verified configuration:
#   DEFAULT_EMBEDDING_PROVIDER=openrouter
#   DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_EMBEDDING_MODEL=autoai-demo-1

# --- Security (server-only secrets) ------------------------------
# Bearer secret required by the MCP endpoint (/api/mcp). Required in production.
MCP_SECRET=
# Bearer secret for cron endpoints; set the same value in Vercel Cron.
# Required in production (cron endpoints fail closed without it).
CRON_SECRET=

# --- Public -------------------------------------------------------
# Absolute site URL used for canonical links/SEO. Safe to expose.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# Internal/test-only (never set in production)
# ============================================================
# AUTOAI_ALLOW_MOCK=1      # enables the mock provider — vitest runner only
# AUTOAI_ALLOW_DEMO_SEED=1 # allows db:seed against NODE_ENV=production
# AUTOAI_QUIET=1           # silences dev log noise
